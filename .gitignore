# --- Secrets: never commit ---
.env
*.pem
*.key
credentials*.json
kaggle.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Data: downloaded by scripts, never committed ---
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.zip
# Large files anywhere else are blocked by the check-added-large-files hook (1 MB).

# --- Models and experiment tracking ---
models/
mlruns/
mlartifacts/
*.pkl
*.joblib

# --- Logs ---
*.log
logs/

# --- OS / editors ---
.DS_Store
Thumbs.db
.vscode/
.idea/
